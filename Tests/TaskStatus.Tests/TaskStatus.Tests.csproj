    <Compile Include="../../WpfTaskBar/Api/Controllers/TaskStatusController.cs" Link="TaskStatusController.cs" />
    <Compile Include="../../WpfTaskBar/Api/Models/TaskStatusModels.cs" Link="TaskStatusModels.cs" />
    <Compile Include="../../WpfTaskBar/Services/TaskStatusStore.cs" Link="TaskStatusStore.cs" />
  </ItemGroup>
