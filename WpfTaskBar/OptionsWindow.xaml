<Window x:Class="WpfTaskBar.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="オプション"
        Height="280"
        Width="360"
        MinHeight="280"
        MinWidth="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="勤怠"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <CheckBox x:Name="AttendanceEnabledCheckBox"
                      Content="出勤・退勤を有効にする"
                      VerticalAlignment="Center" />
            <TextBlock Text="AI"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,20,0,12" />
            <CheckBox x:Name="AiTaskDetailsVisibleCheckBox"
                      Content="AI用の表示欄を表示する"
                      VerticalAlignment="Center" />
            <TextBlock Text="タスク下段の文言を表示します。"
                       Margin="20,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="保存"
                    Width="88"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="SaveButton_OnClick" />
            <Button Content="キャンセル"
                    Width="88"
                    IsCancel="True"
                    Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
