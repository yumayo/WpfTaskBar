<Window x:Class="WpfTaskBar.TaskSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI通知先を変更" Width="620" Height="390" MinWidth="480" MinHeight="390"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="通知IDを維持したまま、表示先のVSCodeウィンドウを変更します。ターミナルやコンテナの再起動は不要です。"
                   TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Label Content="変更する通知" Target="{Binding ElementName=SessionComboBox}" Padding="0,0,0,4" />
            <ComboBox x:Name="SessionComboBox" DisplayMemberPath="Label" SelectionChanged="Session_OnSelectionChanged" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Label Content="通知ID（ターミナルの WPF_TASKBAR_SESSION_ID）" Target="{Binding ElementName=SessionIdTextBox}" Padding="0,0,0,4" />
            <TextBox x:Name="SessionIdTextBox" IsReadOnly="True" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <Label Content="変更後の表示先" Target="{Binding ElementName=TargetComboBox}" Padding="0,0,0,4" />
            <ComboBox x:Name="TargetComboBox" DisplayMemberPath="Label" SelectionChanged="Target_OnSelectionChanged" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="一覧を更新" Width="96" Margin="0,0,8,0" Click="Refresh_OnClick" />
            <Button x:Name="ApplyButton" Content="変更" Width="88" Margin="0,0,8,0" IsEnabled="False" IsDefault="True" Click="Apply_OnClick" />
            <Button Content="閉じる" Width="88" IsCancel="True" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
